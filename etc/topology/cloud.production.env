# cloud.production
SDKWORK_AIOT_DEPLOYMENT_PROFILE=cloud
SDKWORK_AIOT_ENVIRONMENT=production
SDKWORK_AIOT_PROFILE_ID=cloud.production
SDKWORK_DATABASE_ENGINE=postgresql
SDKWORK_DATABASE_HOST=DEPLOY_INJECT:database-host
SDKWORK_DATABASE_PORT=5432
SDKWORK_DATABASE_NAME=sdkwork_ai_prod
SDKWORK_DATABASE_SCHEMA=sdkwork_ai_prod
SDKWORK_DATABASE_USERNAME=sdkwork_ai_prod
SDKWORK_DATABASE_PASSWORD_FILE=/etc/sdkwork/database/database.secret
SDKWORK_DATABASE_SSL_MODE=require
SDKWORK_DATABASE_MAX_CONNECTIONS=20
SDKWORK_AIOT_OUTBOX_DISPATCHER_ENABLED=1
SDKWORK_AIOT_OUTBOX_WEBHOOK_URL=https://events.sdkwork.com/iot/outbox
SDKWORK_AIOT_OUTBOX_WEBHOOK_AUTH=Bearer DEPLOY_INJECT:outbox-webhook-token-min-32-chars
SDKWORK_AIOT_INTERNAL_TOKEN=DEPLOY_INJECT:internal-token-min-32-characters-required
SDKWORK_AIOT_CREDENTIAL_PEPPER=DEPLOY_INJECT:credential-pepper-min-32-characters-required
SDKWORK_CORS_ALLOWED_ORIGINS=https://console.sdkwork.com
SDKWORK_AIOT_TRUST_PROXY_HEADERS=1
SDKWORK_AIOT_XIAOZHI_MCP_POLICY_DENY_BY_DEFAULT=1
SDKWORK_AIOT_INTELLIGENCE_MODE=kernel
SDKWORK_AIOT_INTELLIGENCE_KERNEL_HTTP_URL=DEPLOY_INJECT:kernel-http-url
SDKWORK_CLOUDROUTER_APPLICATION_OPEN_HTTP_URL=DEPLOY_INJECT:cloud-router-http-url
SDKWORK_CLOUDROUTER_API_KEY=DEPLOY_INJECT:cloud-router-api-key-min-32-characters
SDKWORK_AIOT_APPLICATION_PUBLIC_HTTP_URL=https://api.sdkwork.com
SDKWORK_AIOT_APPLICATION_APP_HTTP_URL=https://api.sdkwork.com/app/v3/api/iot
SDKWORK_AIOT_APPLICATION_ADMIN_HTTP_URL=https://api.sdkwork.com/backend/v3/api/iot
SDKWORK_AIOT_EDGE_DEVICE_INGRESS_HTTP_URL=https://edge.aiot.sdkwork.com
SDKWORK_AIOT_EDGE_DEVICE_INGRESS_WEBSOCKET_URL=wss://edge.aiot.sdkwork.com
SDKWORK_AIOT_PLATFORM_API_GATEWAY_HTTP_URL=https://api.sdkwork.com
VITE_SDKWORK_AIOT_DEPLOYMENT_PROFILE=cloud
VITE_SDKWORK_AIOT_ENVIRONMENT=production
VITE_SDKWORK_AIOT_APPLICATION_PUBLIC_HTTP_URL=https://api.sdkwork.com
VITE_SDKWORK_AIOT_APPLICATION_APP_HTTP_URL=https://api.sdkwork.com/app/v3/api/iot
VITE_SDKWORK_AIOT_APPLICATION_ADMIN_HTTP_URL=https://api.sdkwork.com/backend/v3/api/iot
VITE_SDKWORK_AIOT_EDGE_DEVICE_INGRESS_HTTP_URL=https://edge.aiot.sdkwork.com
VITE_SDKWORK_AIOT_EDGE_DEVICE_INGRESS_WEBSOCKET_URL=wss://edge.aiot.sdkwork.com
VITE_SDKWORK_AIOT_PLATFORM_API_GATEWAY_HTTP_URL=https://api.sdkwork.com
VITE_SDKWORK_DRIVE_APP_API_BASE_URL=https://api.sdkwork.com
VITE_SDKWORK_AGENTS_APP_API_BASE_URL=https://agents.sdkwork.com
VITE_SDKWORK_VOICE_APP_API_BASE_URL=https://voice.sdkwork.com


# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_AIOT_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN
