# Bootstrap profile cloud.staging — replace with application-specific values.
SDKWORK_AIOT_DEPLOYMENT_PROFILE=cloud
SDKWORK_AIOT_ENVIRONMENT=staging
SDKWORK_AIOT_PROFILE_ID=cloud.staging
SDKWORK_AIOT_APPLICATION_PUBLIC_HTTP_URL=https://aiot-staging.sdkwork.com
SDKWORK_AIOT_PLATFORM_API_GATEWAY_HTTP_URL=https://api-staging.sdkwork.com
# Dedicated AIoT edge device-ingress plane (naming follows the edge-*.aiot
# family used by development/demo/production env values; see cloudPublicHosts).
SDKWORK_AIOT_EDGE_DEVICE_INGRESS_WEBSOCKET_URL=wss://edge-staging.aiot.sdkwork.com
VITE_SDKWORK_AIOT_EDGE_DEVICE_INGRESS_WEBSOCKET_URL=wss://edge-staging.aiot.sdkwork.com


# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_AIOT_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN

